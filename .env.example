# Copie para .env e preencha com os dados do seu projeto Supabase
# (Project Settings → API). Sem essas variáveis, o app roda em
# modo demonstração com dados em memória.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Maps (opcional). Sem chave, busca e mapa usam o OpenStreetMap.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAP_ID=

# Força o modo demonstração mesmo com Supabase configurado
VITE_USE_MOCK=false
